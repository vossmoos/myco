# Copy to .env (never commit it) and fill in what you use.
# Only MYCO_* variables reach the running container; SCW_*/DEPLOY_* are read by deploy.sh.

# ============================================================== Sources
# MYCO_SOURCE__<NAME>__<SETTING>. The lowercased NAME becomes the source name, the first
# part of every tool (zendesk_get_ticket), label (zendesk:ticket:read) and role
# (zendesk:reader). TYPE picks the pack and defaults to NAME. Remove a block to disable it.

# Zendesk
MYCO_SOURCE__ZENDESK__DOMAIN=acme.zendesk.com
MYCO_SOURCE__ZENDESK__API_KEY=
# MYCO_SOURCE__ZENDESK__TIMEOUT=30

# Jira Cloud
MYCO_SOURCE__JIRA__SITE=acme.atlassian.net
MYCO_SOURCE__JIRA__EMAIL=bot@acme.com
MYCO_SOURCE__JIRA__API_TOKEN=
# Optional: confine every Jira tool to these projects
# MYCO_SOURCE__JIRA__PROJECTS=OPS,SUP

# Wrike
MYCO_SOURCE__WRIKE__TOKEN=
# EU data centre accounts:
# MYCO_SOURCE__WRIKE__BASE_URL=https://app-eu.wrike.com/api/v4

# A second Zendesk account, published as support_eu_* tools and support_eu:* roles:
# MYCO_SOURCE__SUPPORT_EU__TYPE=zendesk
# MYCO_SOURCE__SUPPORT_EU__DOMAIN=acme-eu.zendesk.com
# MYCO_SOURCE__SUPPORT_EU__API_KEY=

# ============================================================== Agent keys
# MYCO_AGENT__<NAME>__KEY. Agent "support-bot" -> MYCO_AGENT__SUPPORT_BOT__KEY.
# Each key needs a matching config/agents/<name>.yaml; without one it sees no tools.
# deploy.sh generates the default key when this line is missing or empty.
MYCO_AGENT__DEFAULT__KEY=
# MYCO_AGENT__SUPPORT_BOT__KEY=

# ============================================================== Users (optional)
# Validate forwarded SSO tokens (X-Myco-User-Token header). Without these, a forwarded
# token is rejected. Calls without a token run as the agent's service user (users.yaml),
# else as the built-in "anonymous" user, which has no roles in the example config.
# MYCO_OIDC__ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# MYCO_OIDC__AUDIENCE=api://myco
# MYCO_OIDC__JWKS_URL=          # default: read from the issuer's discovery document

# ============================================================== Runtime (optional)
# MYCO_CONFIG_DIR=config        # the container uses /config
# MYCO_PORT=8080
# MYCO_MCP_PATH=/mcp
# MYCO_RELOAD_SECONDS=10        # 0 disables hot reload of the config folder
# MYCO_AUDIT_FILE=              # JSON lines; stdout always gets them too
# MYCO_LOG_LEVEL=INFO
# MYCO_PLUGINS=acme_crm         # extra connector modules to import (comma-separated)
# MYCO_USER_TOKEN_HEADER=X-Myco-User-Token
# MYCO_STATELESS_HTTP=false     # true to run several replicas without sticky sessions

# ============================================================== Scaleway deploy (deploy.sh)
# IAM -> API keys: the *secret* key (UUID), not the access key (SCW...).
SCW_SECRET_KEY=
SCW_REGION=fr-par
SCW_REGISTRY_NAMESPACE=myco
# Kapsule cluster id; deploy.sh installs its kubeconfig with the scw CLI. Leave empty to
# use the current kubectl context (or set DEPLOY_KUBE_CONTEXT).
SCW_K8S_CLUSTER_ID=
# DEPLOY_KUBE_CONTEXT=

DEPLOY_NAMESPACE=myco
DEPLOY_RELEASE=myco
# Public hostname; needs an ingress controller and cert-manager in the cluster.
# Leave empty to keep Myco cluster-internal (port-forward).
DEPLOY_HOST=
# DEPLOY_INGRESS_CLASS=nginx
# DEPLOY_CLUSTER_ISSUER=letsencrypt-prod

# Permissions source. Default: ./config shipped as a ConfigMap on every deploy.
# Or keep permissions in their own Git repo, synced by a git-sync sidecar:
# DEPLOY_GIT_REPO=https://github.com/acme/myco-config.git
# DEPLOY_GIT_REF=main
# DEPLOY_GIT_PATH=tenants/acme      # folder holding agents/, users.yaml, domains.yaml
# DEPLOY_GIT_SECRET=myco-git        # Secret with GITSYNC_USERNAME / GITSYNC_PASSWORD
